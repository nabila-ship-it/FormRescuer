{
  "manifest_version": 3,
  "name": "FormRescuer - Real-time Form Auto-Save & Recovery",
  "short_name": "FormRescuer",
  "version": "1.0.0",
  "description": "Menyelamatkan data ketikan formulir dan Google Form Anda secara otomatis dan instan saat browser tidak sengaja tertutup.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs"
  ],
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "FormRescuer - Status Formulir"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["demo/*", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
